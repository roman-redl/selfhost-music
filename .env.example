# Environment variables for selfhost-music
# Copy to .env and fill in your values

# Domain for Caddy/Navidrome
DOMAIN=music.yourdomain.duckdns.org

# Paths on VPS
MUSIC_DIR=/music
MUSIC_INBOX=/music-inbox
NAVIDROME_DATA_DIR=/data

# Mail.ru cloud backup (app password, not email password)
MAILRU_EMAIL=your-backup@mail.ru
MAILRU_APP_PASSWORD=your-app-password
