# selfhost-music environment variables
# Copy to .env and fill in your values (.env is gitignored)

# Domain for Caddy/Navidrome
DOMAIN=music.yourdomain.duckdns.org

# DuckDNS credentials for dynamic DNS updates
DUCKDNS_TOKEN=your-duckdns-token
DUCKDNS_SUBDOMAIN=your-subdomain

# VPS connection
VPS_IP=your.vps.ip.address
SSH_KEY=~/.ssh/id_ed25519_oracle

# Oracle Cloud region
ORACLE_REGION=eu-frankfurt-1

# Paths on VPS
MUSIC_DIR=/opt/selfhost-music/music
MUSIC_INBOX=/opt/selfhost-music/music-inbox
NAVIDROME_DATA_DIR=/opt/selfhost-music/data

# Navidrome credentials (API calls in maintenance scripts; URL-encode the password — it may contain '#')
NAVIDROME_USER=your-navidrome-user
NAVIDROME_PASSWORD=your-navidrome-password

# Mail.ru cloud backup (app password from account security settings, NOT the email password)
MAILRU_EMAIL=your-backup@mail.ru
MAILRU_APP_PASSWORD=-
