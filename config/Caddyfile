{
	# CONNECT requests must reach forward_proxy before the site handler,
	# otherwise they fall through to reverse_proxy
	order forward_proxy first
}

{$DOMAIN:music.yourdomain.duckdns.org} {
    # Personal Claude API: reverse route to Anthropic behind a token.
    # Replaces the HTTPS_PROXY scheme: Claude Code targets this URL via
    # ANTHROPIC_BASE_URL, Caddy itself egresses to api.anthropic.com from
    # the VPS IP. Token: {$CLAUDE_ROUTE_TOKEN} from .env via compose.
    handle /anthropic/* {
        # `route` keeps the written order: strip prefix, proxy when the
        # token matches, otherwise fall through to 403. (A nested `handle`
        # gets flattened by the adapter; bare `respond` would fire first.)
        route {
            @authorized header X-Proxy-Token {$CLAUDE_ROUTE_TOKEN}
            uri strip_prefix /anthropic
            reverse_proxy @authorized https://api.anthropic.com {
                header_up Host api.anthropic.com
                flush_interval -1
            }
            respond 403
        }
    }

    handle {
        reverse_proxy navidrome:4533
    }

    # Uncomment for Audiobookshelf (Stage 9)
    # handle_path /abs/* {
    #     reverse_proxy audiobookshelf:80
    # }
}

# Catch-all on :443 for the forward proxy. A proxied request carries the
# TARGET host (api.anthropic.com), which never matches the named music site
# above — without this block Caddy answers it with a bare empty 200 and the
# plugin is never reached. Unauthenticated probes fall through to Caddy's
# empty response (probe_resistance); credentials come from .env via compose.
:443 {
	forward_proxy {
		basic_auth {$PROXY_USER} {$PROXY_PASSWORD}
		ports 443
		hide_ip
		hide_via
		probe_resistance
		acl {
			# Opened 2026-11-03: personal claude-api sessions route ALL their
			# web tools through this proxy (geo-blocks from BY IPs); corporate
			# hosts are excluded client-side via NO_PROXY. Basic auth still
			# gates everything; rotate PROXY_PASSWORD on any suspicion.
			allow all
		}
	}
}
