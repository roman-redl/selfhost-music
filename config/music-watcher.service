[Unit]
Description=Music inbox watcher — auto-imports new files into Navidrome
After=network.target docker.service

[Service]
Type=simple
ExecStart=/opt/selfhost-music/scripts/watch-inbox.sh
Restart=always
RestartSec=10
User=root
StandardOutput=append:/var/log/music-import.log
StandardError=append:/var/log/music-import.log

[Install]
WantedBy=multi-user.target
